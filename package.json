{
  "name": "storyweave",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的小说创作工作室",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild:native": "electron-rebuild --only better-sqlite3"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-unique-id": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "better-sqlite3": "13.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.2",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
